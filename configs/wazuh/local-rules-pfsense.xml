<!-- Sanitized Wazuh custom rules (/var/ossec/etc/rules/local_rules.xml) for pfSense filterlog -->
<group name="pfsense,firewall,local,">
  <!-- Baseline rule for pfSense filterlog drop/block events -->
  <rule id="100901" level="5">
    <decoded_as>pf-filterlog</decoded_as>
    <field name="action">^block$</field>
    <description>pfSense firewall blocked network connection</description>
    <group>firewall_drop,</group>
  </rule>

  <!-- High-severity correlation rule for blocked connections to known test/malware IOCs -->
  <rule id="100903" level="12">
    <if_sid>100901</if_sid>
    <field name="dstip">^89\.238\.73\.97$</field>
    <description>Malware Download Attempt Blocked by pfSense</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>malware_block,perimeter_defense,</group>
  </rule>
</group>
